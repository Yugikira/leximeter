# ==============================================================================
# Leximeter 配置模板
# 复制为 .env 并填写;真实环境变量优先于 .env(不改代码即可覆盖)。
# 支持的键即下方清单,全部可选。
# ==============================================================================

# ── LLM 协议与端点 ───────────────────────────────────────────────────────────
# 协议:"responses"(OpenAI Responses API,默认)| "chat"(Chat Completions,
#      DeepSeek / MiniMax / Ollama / vLLM / 任何 OpenAI 兼容网关)
# LEXIMETER_PROTOCOL=chat
# LEXIMETER_BASE_URL=https://api.deepseek.com
# LEXIMETER_API_KEY=sk-...
# LEXIMETER_MODEL=deepseek-chat

# 未设 LEXIMETER_API_KEY 时的 OpenAI 兜底(Responses 协议默认)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# ── safest_json 的 LLM 修复模型(解析兜底,默认 gpt-5.4-mini)────────────────
# JSON_LLM_MODEL=gpt-5.4-mini

# ── 嵌入 provider:"local"(默认,本地 BGE)或 "openai" ─────────────────────────
# LEXIMETER_EMBEDDING_PROVIDER=local
# LEXIMETER_EMBEDDING_MODEL=BAAI/bge-m3
# openai 专用：嵌入端点/密钥可与 LLM 分开配置(如 SiliconFlow 等独立嵌入服务;
# 不设则默认同 LEXIMETER_BASE_URL / LEXIMETER_API_KEY)
# LEXIMETER_EMBEDDING_BASE_URL=
# LEXIMETER_EMBEDDING_API_KEY=

# ── 联网搜索 provider:"tavily" | "none"(默认)────────────────────────────────
# LEXIMETER_SEARCH_PROVIDER=none
# TAVILY_API_KEY=tvly-...

# ── 决策模型 provider(System One):"systemone" | "dummy" | "none"(默认禁用)──
# 支持 TypeSafe Jev、OpenRouter (/api/v1/systemone 或 /api/alpha/decisions)、
# AMD Token Factory (d3 / d3-flash) 及自托管 vLLM / SGLang。不配置时自动回退 LLM。
# LEXIMETER_DECISION_PROTOCOL=none
# LEXIMETER_DECISION_BASE_URL=https://openrouter.ai/api
# LEXIMETER_DECISION_API_KEY=sk-or-...
# LEXIMETER_DECISION_MODEL=cloudflare/clef-flash
