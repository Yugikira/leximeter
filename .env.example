# ==============================================================================
# Leximeter 配置模板
# 复制为 .env 并填写;真实环境变量优先于 .env(不改代码即可覆盖)。
# 支持的键即下方清单,全部可选。
# ==============================================================================

# ── LLM 协议与端点 ───────────────────────────────────────────────────────────
# 协议:"responses"(OpenAI Responses API,默认)| "chat"(Chat Completions,
#      DeepSeek / MiniMax / Ollama / vLLM / 任何 OpenAI 兼容网关)
# LEXIMETER_PROTOCOL=chat
# LEXIMETER_BASE_URL=https://api.deepseek.com
# LEXIMETER_API_KEY=sk-...
# LEXIMETER_MODEL=deepseek-chat

# 未设 LEXIMETER_API_KEY 时的 OpenAI 兜底(Responses 协议默认)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# ── safest_json 的 LLM 修复模型(解析兜底,默认 gpt-5.4-mini)────────────────
# JSON_LLM_MODEL=gpt-5.4-mini

# ── 嵌入 provider:"local"(默认,本地 BGE)或 "openai" ─────────────────────────
# LEXIMETER_EMBEDDING_PROVIDER=local
# LEXIMETER_EMBEDDING_MODEL=BAAI/bge-m3

# ── 联网搜索 provider:"tavily" | "none"(默认)────────────────────────────────
# LEXIMETER_SEARCH_PROVIDER=none
# TAVILY_API_KEY=tvly-...
